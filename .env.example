# OpenSky Network API Configuration (Optional)
# Anonymous access is supported by default (rate-limited to 1 request / 10s).
# If you have an OpenSky registered account or OAuth2 client credentials, provide them below.

# Basic Auth (Classic)
OPENSKY_USERNAME=your_opensky_username
OPENSKY_PASSWORD=your_opensky_password

# OAuth2 Client Credentials (Modern OpenSky Auth)
OPENSKY_CLIENT_ID=your_client_id
OPENSKY_CLIENT_SECRET=your_client_secret

# Vite Dev Server Port
PORT=5173
